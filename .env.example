# Set these in the Vercel project as Environment Variables.
# The contact form returns an explicit setup error until all three are present.
# CONTACT_FROM_EMAIL must be a sender address verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional. Vercel sets the public host automatically.
# Set this only when canonical URLs should use a specific domain.
SITE_URL=

# Optional. A Telegram alert with the same enquiry details.
# Message the bot once, then read the chat id from getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Meta Pixel for the Black Friday page. Leave empty to skip the script.
NEXT_PUBLIC_META_PIXEL_ID=

# Optional. Form POST URL for the Black Friday page. Empty shows the copy-message fallback.
# Use /black-friday/send to keep the Telegram route, or a Web3Forms URL.
NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_WEB3FORMS_KEY=
